# Local API server
SERVER_PORT=1255
GIN_MODE=debug

# MySQL (the supplied database.sql initializes the teslaapp database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-this-local-password
DB_NAME=teslaapp

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Use a unique random value outside local development.
JWT_SECRET=replace-with-a-random-64-character-secret
JWT_EXPIRES_IN=604800
JWT_REFRESH_EXPIRES_IN=2592000

# Tesla China Fleet API. Required to authorize and use a real vehicle.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=http://localhost:1255/api/tesla/callback
TESLA_AUTH_URL=https://auth.tesla.cn/oauth2/v3/authorize
TESLA_TOKEN_URL=https://auth.tesla.cn/oauth2/v3/token
TESLA_FLEET_API_URL=https://fleet-api.prd.cn.vn.cloud.tesla.cn
TESLA_AUDIENCE=https://fleet-api.prd.cn.vn.cloud.tesla.cn
TESLA_VCP_URL=
TESLA_PARTNER_DOMAIN=
TESLA_FRONTEND_CALLBACK_URL=http://localhost:3001/#/pages/callback/callback

# Optional services
TENCENT_MAP_KEY=
AI_API_KEY=
AI_MODEL=glm-4-flash
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Disabled locally because Fleet Telemetry needs a public HTTPS hostname and certificates.
TELEMETRY_ENABLED=false
CERT_SYNC_ENABLED=false
